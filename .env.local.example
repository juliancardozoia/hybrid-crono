# Supabase — las tres primeras salen de tu proyecto en supabase.com
# (Project Settings -> API). Copia este archivo a .env.local y complétalo.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETO: saltea RLS. Solo se usa desde el servidor, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cifra las credenciales de pasarela del organizador (AES-256-GCM).
# Minimo 32 caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENTS_ENCRYPTION_KEY=

# --- Correos transaccionales -------------------------------------------------
# `log` escribe cada correo en .correos-dev/ y NO envia nada (desarrollo, sin
# dominio). `resend` envia de verdad. Sin la variable, en produccion el envio
# falla a proposito en vez de caer en `log`.
EMAIL_DRIVER=log

# Solo con EMAIL_DRIVER=resend. El remitente tiene que ser de un dominio
# verificado en Resend (SPF/DKIM); para probar sin dominio, Resend ofrece
# "Scora <onboarding@resend.dev>" enviando SOLO a tu propio correo.
RESEND_API_KEY=
EMAIL_FROM=
# Opcional: adonde llegan las respuestas (los correos salen de una casilla
# que nadie lee).
EMAIL_REPLY_TO=

# Firma de los eventos de rebote/queja (Resend -> Webhooks, endpoint
# <origen>/api/correos/eventos). Empieza con whsec_.
RESEND_WEBHOOK_SECRET=

# Protege el barrido de reintentos (/api/correos/procesar). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sin ella la ruta responde 503 en vez de abrirse.
CRON_SECRET=
